@model CSDLVanHoaDuLichSonLa.Models.ViewPermissionViewModel

<div class="box_content">
    <div class="TieuDe">
        <h2 id="pageTitle">@ViewBag.Title</h2>
    </div>

    <div class="content-body">
        <form id="formToChuc">
            <!-- Thông tin cơ bản -->
            <div class="row">
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="sucChua">Sức chứa</label>
                        <input type="number" class="form-control" id="sucChua" min="1" placeholder="Nhập sức chứa (số người)" />
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="loaiHinh">Loại hình dịch vụ <span class="text-danger">*</span></label>
                        <select class="form-control" id="loaiHinh">
                            <option value="">Chọn loại hình dịch vụ</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="soDienThoai">Số điện thoại</label>
                        <input type="tel" class="form-control" id="soDienThoai" maxlength="20" placeholder="Nhập số điện thoại" />
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="hopThu">Hộp thư</label>
                        <input type="email" class="form-control" id="hopThu" maxlength="100" placeholder="Nhập địa chỉ email" />
                    </div>
                </div>
                <div class="col-lg-6 col-md-12">
                    <div class="form-group">
                        <label for="website">Website</label>
                        <input type="url" class="form-control" id="website" maxlength="200" placeholder="Nhập địa chỉ website" />
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="gioMoCua">Giờ mở cửa</label>
                        <input type="time" class="form-control" id="gioMoCua" placeholder="Chọn giờ mở cửa" />
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="gioDongCua">Giờ đóng cửa</label>
                        <input type="time" class="form-control" id="gioDongCua" placeholder="Chọn giờ đóng cửa" />
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="ngayNghi">Ngày nghỉ</label>
                        <input type="text" class="form-control" id="ngayNghi" maxlength="100" placeholder="Ví dụ: Thứ 2, Chủ nhật" />
                    </div>
                </div>

                @* <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="tinhThanhPho">Tỉnh/Thành phố</label>
                        <select class="form-control" id="tinhThanhPho">
                            <option value="">Chọn tỉnh/thành phố</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="phuongXa">Phường/Xã/Đặc khu</label>
                        <select class="form-control" id="phuongXa">
                            <option value="">Chọn phường/xã</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="toaDoX">Tọa độ X (Kinh độ)</label>
                        <input type="number" class="form-control" id="toaDoX" step="0.000001" placeholder="Nhập tọa độ X" />
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="toaDoY">Tọa độ Y (Vĩ độ)</label>
                        <input type="number" class="form-control" id="toaDoY" step="0.000001" placeholder="Nhập tọa độ Y" />
                    </div>
                </div> *@
                <div class="col-lg-3 col-md-12">
                    <div class="form-group">
                        <label for="loaiHinh">Tên địa điểm <span class="text-danger">*</span></label>
                        <select class="form-control" id="diaDiem" required>
                            <option value="">Chọn địa điểm</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="luotDanhGia">Lượt đánh giá</label>
                        <input type="number" class="form-control" id="luotDanhGia" min="0" placeholder="Nhập số lượt đánh giá" />
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="diemDanhGia">Điểm đánh giá</label>
                        <input type="number" class="form-control" id="diemDanhGia" min="0" max="5" step="0.1" placeholder="Nhập điểm đánh giá (0-5)" />
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label for="thuTu">Thứ tự</label>
                        <input type="number" class="form-control" id="thuTu" min="1" placeholder="Nhập thứ tự hiển thị" />
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label>Trạng thái</label>
                        <div class="form-check-container">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="trangThai" id="trangThaiDuyet" value="1" checked>
                                <label class="form-check-label" for="trangThaiDuyet">Duyệt</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="trangThai" id="trangThaiChuaDuyet" value="0">
                                <label class="form-check-label" for="trangThaiChuaDuyet">Chưa duyệt</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label>Tiệc gia đình</label>
                        <div class="form-check-container">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="tiecGiaDinh" id="tiecGiaDinhCo" value="1" checked>
                                <label class="form-check-label" for="tiecGiaDinhCo">Có</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="tiecGiaDinh" id="tiecGiaDinhKhong" value="0">
                                <label class="form-check-label" for="tiecGiaDinhKhong">Không</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label>Tiệc đông người</label>
                        <div class="form-check-container">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="tiecDongNguoi" id="tiecDongNguoiCo" value="1" checked>
                                <label class="form-check-label" for="tiecDongNguoiCo">Có</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="tiecDongNguoi" id="tiecDongNguoiKhong" value="0">
                                <label class="form-check-label" for="tiecDongNguoiKhong">Không</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label>Có phòng riêng</label>
                        <div class="form-check-container">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="coPhongRieng" id="coPhongRiengCo" value="1" checked>
                                <label class="form-check-label" for="coPhongRiengCo">Có</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="coPhongRieng" id="coPhongRiengKhong" value="0">
                                <label class="form-check-label" for="coPhongRiengKhong">Không</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label>Có khu vui chơi trẻ em</label>
                        <div class="form-check-container">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="coKhuVuiChoiTreEm" id="coKhuVuiChoiTreEmCo" value="1" checked>
                                <label class="form-check-label" for="coKhuVuiChoiTreEmCo">Có</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="coKhuVuiChoiTreEm" id="coKhuVuiChoiTreEmKhong" value="0">
                                <label class="form-check-label" for="coKhuVuiChoiTreEmKhong">Không</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="form-group">
                        <label>Chuẩn du lịch</label>
                        <div class="form-check-container">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="chuanDuLich" id="chuanDuLichCo" value="1" checked>
                                <label class="form-check-label" for="chuanDuLichCo">Có</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="chuanDuLich" id="chuanDuLichKhong" value="0">
                                <label class="form-check-label" for="chuanDuLichKhong">Không</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Phần đa ngữ -->
            <div class="DaNgu">
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label for="ngonNguDich">Ngôn ngữ dịch</label>
                            <select class="form-control" id="ngonNguDich">
                                <option value="">Chọn ngôn ngữ</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label for="tenCoSo">Tên cơ sở <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="tenCoSo" maxlength="255" placeholder="Nhập tên cơ sở ăn uống" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label for="nguoiDaiDien">Người đại diện</label>
                            <input type="text" class="form-control" id="nguoiDaiDien" maxlength="100" placeholder="Nhập tên người đại diện" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label for="diaChi">Địa chỉ <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="diaChi" rows="3" maxlength="500" placeholder="Nhập địa chỉ cụ thể"></textarea>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label for="moTa">Mô tả</label>
                            <textarea class="form-control" id="moTa" rows="5" maxlength="1000" placeholder="Nhập mô tả về cơ sở ăn uống"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nút hành động -->
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <div class="group-button flex-end">
                            <a href="@Url.Action("Index", "CoSoAnUong")" class="btn btn-outline-primary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary">
                                Lưu
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Có thể thêm các script xử lý form ở đây
    </script>
    <script src="~/PageScripts/admin/CoSoAnUong/Add.js" asp-append-version="true"></script>
}