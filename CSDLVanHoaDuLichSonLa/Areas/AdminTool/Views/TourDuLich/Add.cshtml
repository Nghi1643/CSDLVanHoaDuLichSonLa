            </div>
            <div class="tab-pane fade" id="DaPhuongTien" role="tabpanel" aria-labelledby="DaPhuongTien-tab">
                <div id="DiaDiemCoSan">
                    <div class="form-group">
                        <label for="DiaDiemCoSanAdd">Chọn thể loại có sẵn <span class="text-danger">*</span></label>
                        <select class="form-control" id="theLoaiCoSanAdd">
