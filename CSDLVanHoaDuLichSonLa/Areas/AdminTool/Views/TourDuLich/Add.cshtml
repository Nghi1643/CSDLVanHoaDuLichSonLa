<div class="box_content">
    <div class="TieuDe">
        <h2>@ViewBag.Title</h2>
    </div>
    <div class="content-body">
        <ul class="nav nav-tabs" id="TabSuKien" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="ThongTinSuKien-tab" data-toggle="tab" href="#ThongTinSuKien" role="tab" aria-controls="ThongTinSuKien" aria-selected="true">Thông tin tour du lịch</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="ViTriBanDo-tab" data-toggle="tab" href="#ViTriBanDo" role="tab" aria-controls="ViTriBanDo" aria-selected="false">Lộ trình tour</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="DaPhuongTien-tab" data-toggle="tab" href="#DaPhuongTien" role="tab" aria-controls="DaPhuongTien" aria-selected="false">Loại hình tour</a>
            </li>
        </ul>
        <div class="tab-content" id="TabContent">
            <div class="tab-pane fade show active" id="ThongTinSuKien" role="tabpanel" aria-labelledby="ThongTinSuKien-tab">
                <form id="formSuKienAdd">
                    <div class="row">
                        <div class="col-lg col-md-12">
                            <div class="row">
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="maSuKien">Mã định danh <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="maDinhDanh" placeholder="Nhập mã định đanh" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="toChuc">Tổ Chức</label>
                                    <select class="form-control" id="toChuc">
                                        <option value="">Chọn tổ chức</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="phanKhuc">Phân khúc tour</label>
                                    <select class="form-control" id="phanKhuc">
                                        <option value="">Chọn phân khúc</option>
                                    </select>
                                </div>
                                @* <div class="form-group col-lg-3 col-md-12">
                                    <label for="trangThaiSuKien">Thể Loại tour</label>
                                    <select class="form-control" id="theLoai">
                                        <option value="">Chọn trạng thái sự kiện</option>
                                    </select>
                                </div> *@
                                @* LoaiHinhID(danh mục chung),PhanKhucID(danh mục chung),DiemDiID(địa điểm),DiemDenID(địa điểm),PhuongTienID(danh mục chung),MaNgonNgu(Ngôn ngữ)*@
                                @* SoKhachToiThieu,SoKhachToiDa,GiaTour,GiaNguoi,SoLuotDanhGia,DiemDanhGia *@
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="loaiHinh">Loại hình tour </label>
                                    <select class="form-control" id="loaiHinh">
                                        <option value="">Chọn loại hình</option>
                                    </select>
                                </div>
                                
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="diemDi">
                                        Điểm đi
                                        <span type="button" class="ml-2"
                                                     data-toggle="modal"
                                                     data-target="#modalAddDiaDiem" title="Thêm địa điểm mới">
                                            <i class="fa fa-plus-circle fa-lg text-success"></i>
                                        </span>
                                    </label>
                                    <select class="form-control" id="diemDi">
                                        <option value="">Chọn điểm đi</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="ngayBatDau">Ngày bắt đầu </label>
                                    <input type="text" class="form-control datepicker" id="ngayBatDauAdd" placeholder="dd/mm/yyyy" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="diemDen">
                                        Điểm đến
                                        <span type="button" class="ml-2" 
                                        data-toggle="modal" 
                                        data-target="#modalAddDiaDiem" title="Thêm địa điểm mới">
                                            <i class="fa fa-plus-circle fa-lg text-success"></i>
                                        </span>
                                    </label>
                                    <select class="form-control" id="diemDen">
                                        <option value="">Chọn điểm đến</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="ngayKetThuc">Ngày kết thúc </label>
                                    <input type="text" class="form-control datepicker" id="ngayKetThucAdd" placeholder="dd/mm/yyyy" />
                                </div>
                               
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="phuongTien">Phương tiện</label>
                                    <select class="form-control" id="phuongTien">
                                        <option value="">Chọn phương tiện</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <div class="form-group">
                                        <label for="ngonNguDich">Ngôn ngữ hướng dẫn chính trong tour</label>
                                        <select class="form-control ngonNguDich" id="ngonNguDich">
                                            <option value="">Chọn ngôn ngữ</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="soKhachToiThieu">Số khách tối thiểu</label>
                                    <input type="number" class="form-control" id="soKhachToiThieu" min="1" placeholder="Nhập số khách tối thiểu" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="soKhachToiDa">Số khách tối đa</label>
                                    <input type="number" class="form-control" id="soKhachToiDa" min="1" placeholder="Nhập số khách tối đa" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="giaTour">Giá tour (VNĐ)</label>
                                    <input type="number" class="form-control" id="giaTour" min="0" placeholder="Nhập giá tour" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="giaNguoi">Giá/người - với tour ghép (VNĐ)</label>
                                    <input type="number" class="form-control" id="giaNguoi" min="0" placeholder="Nhập giá/người" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="soLuotDanhGia">Số lượt đánh giá</label>
                                    <input type="number" class="form-control" id="soLuotDanhGia" min="0" placeholder="Số lượt đánh giá"  />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="diemDanhGia">Điểm đánh giá (1-5)</label>
                                    <input type="number" class="form-control" id="diemDanhGia" min="1" max="5" step="1" placeholder="Điểm đánh giá"  />
                                </div>

                                <div class="form-group col-lg-3 col-md-12">
                                    <label>Trạng thái</label>
                                    <div class="form-check-container">
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="trangThai" id="trangThaiDuyet" value="1" checked>
                                            <label class="form-check-label" for="trangThaiDuyet">Duyệt</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="trangThai" id="trangThaiChuaDuyet" value="0">
                                            <label class="form-check-label" for="trangThaiChuaDuyet">Chưa duyệt</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @* <div class="row">
                        
                    </div> *@
                    <!-- Đa ngữ -->
                    <div class="DaNgu">
                        <div class="row">
                            <div class="col-12 col-md-12">
                                <div class="form-group">
                                    <label for="ngonNguDichAdd">Ngôn ngữ dịch</label>
                                    <select class="form-control ngonNguDich" id="ngonNguDichAdd">
                                        <option value="">Chọn ngôn ngữ</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-md-12">
                                <div class="form-group">
                                    <label for="tenSuKienDichAdd">Tên tour du lịch<span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="tenTour" placeholder="Nhập tên tour du lịch" />
                                </div>
                            </div>
                            <div class="col-12 col-md-12">
                                <div class="form-group">
                                    <label for="ketQuaAdd">Thời gian</label>
                                    <input type="text" class="form-control" id="thoiGian" placeholder="Nhập thời gian tour(vd:4 ngày 1 đêm)" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="noiDungAdd">Mô tả</label>
                                    <textarea class="form-control" id="moTaAdd" rows="3" placeholder="Nhập mô tả"></textarea>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="noiDungAdd">Các trải nghiệm của du khách khi tham gia chuyến di</label>
                                    <textarea class="form-control" id="traiNghiem" rows="3" placeholder="Nhập các trải nghiệm"></textarea>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="noiDungAdd">Các khuyến cáo, gợi ý, mẹo hữu ích dành cho du khách</label>
                                    <textarea class="form-control" id="goiY" rows="3" placeholder="Nhập khuyến cáo, gợi ý, mẹo"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="tab-pane fade" id="ViTriBanDo" role="tabpanel" aria-labelledby="ViTriBanDo-tab">

