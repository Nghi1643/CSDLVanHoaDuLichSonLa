@model CSDLVanHoaDuLichSonLa.Models.ViewPermissionViewModel
@{
    ViewBag.Title = "Chỉnh sửa tour du lịch";
}

<div class="box_content">
    <div class="TieuDe">
        <h2>@ViewBag.Title</h2>
    </div>
    <div class="content-body">
        <ul class="nav nav-tabs" id="TabTourDuLich" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="ThongTinTour-tab" data-toggle="tab" href="#ThongTinTour" role="tab" aria-controls="ThongTinTour" aria-selected="true">Thông tin tour du lịch</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="LoTrinh-tab" data-toggle="tab" href="#LoTrinh" role="tab" aria-controls="LoTrinh" aria-selected="false">Lộ trình tour</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="TheLoaiTour-tab" data-toggle="tab" href="#TheLoaiTour" role="tab" aria-controls="TheLoaiTour" aria-selected="false">Loại hình tour</a>
            </li>
        </ul>
        <div class="tab-content" id="TabContent">
            <div class="tab-pane fade show active" id="ThongTinTour" role="tabpanel" aria-labelledby="ThongTinTour-tab">
                <form id="formTourEdit">
                    <div class="row">
                        <div class="col-lg col-md-12">
                            <div class="row">
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="maDinhDanh">Mã định danh <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="maDinhDanh" placeholder="Nhập mã định đanh" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="toChuc">Tổ Chức</label>
                                    <select class="form-control" id="toChuc">
                                        <option value="">Chọn tổ chức</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="phanKhuc">Phân khúc tour</label>
                                    <select class="form-control" id="phanKhuc">
                                        <option value="">Chọn phân khúc</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="loaiHinh">Loại hình tour</label>
                                    <select class="form-control" id="loaiHinh">
                                        <option value="">Chọn loại hình</option>
                                    </select>
                                </div>

                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="diemDi">
                                        Điểm đi
                                        <span type="button" class="ml-2"
                                              data-toggle="modal"
                                              data-target="#modalAddDiaDiem" title="Thêm địa điểm mới">
                                            <i class="fa fa-plus-circle fa-lg text-success"></i>
                                        </span>
                                    </label>
                                    <select class="form-control" id="diemDi">
                                        <option value="">Chọn điểm đi</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="ngayBatDau">Ngày bắt đầu</label>
                                    <input type="text" class="form-control datepicker" id="ngayBatDauEdit" placeholder="dd/mm/yyyy" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="diemDen">
                                        Điểm đến
                                        <span type="button" class="ml-2"
                                              data-toggle="modal"
                                              data-target="#modalAddDiaDiem" title="Thêm địa điểm mới">
                                            <i class="fa fa-plus-circle fa-lg text-success"></i>
                                        </span>
                                    </label>
                                    <select class="form-control" id="diemDen">
                                        <option value="">Chọn điểm đến</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="ngayKetThuc">Ngày kết thúc</label>
                                    <input type="text" class="form-control datepicker" id="ngayKetThucEdit" placeholder="dd/mm/yyyy" />
                                </div>

                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="phuongTien">Phương tiện</label>
                                    <select class="form-control" id="phuongTien">
                                        <option value="">Chọn phương tiện</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <div class="form-group">
                                        <label for="ngonNguDich">Ngôn ngữ hướng dẫn chính trong tour</label>
                                        <select class="form-control ngonNguDich" id="ngonNguDich">
                                            <option value="">Chọn ngôn ngữ</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="soKhachToiThieu">Số khách tối thiểu</label>
                                    <input type="number" class="form-control" id="soKhachToiThieu" min="1" placeholder="Nhập số khách tối thiểu" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="soKhachToiDa">Số khách tối đa</label>
                                    <input type="number" class="form-control" id="soKhachToiDa" min="1" placeholder="Nhập số khách tối đa" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="giaTour">Giá tour (VNĐ)</label>
                                    <input type="number" class="form-control" id="giaTour" min="0" placeholder="Nhập giá tour" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="giaNguoi">Giá/người - với tour ghép (VNĐ)</label>
                                    <input type="number" class="form-control" id="giaNguoi" min="0" placeholder="Nhập giá/người" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="soLuotDanhGia">Số lượt đánh giá</label>
                                    <input type="number" class="form-control" id="soLuotDanhGia" min="0" placeholder="Số lượt đánh giá" />
                                </div>
                                <div class="form-group col-lg-3 col-md-12">
                                    <label for="diemDanhGia">Điểm đánh giá (1-5)</label>
                                    <input type="number" class="form-control" id="diemDanhGia" min="1" max="5" step="1" placeholder="Điểm đánh giá" />
                                </div>

                                <div class="form-group col-lg-3 col-md-12">
                                    <label>Trạng thái</label>
                                    <div class="form-check-container">
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="trangThai" id="trangThaiDuyet" value="1" checked>
                                            <label class="form-check-label" for="trangThaiDuyet">Duyệt</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="trangThai" id="trangThaiChuaDuyet" value="0">
                                            <label class="form-check-label" for="trangThaiChuaDuyet">Chưa duyệt</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Đa ngữ -->
                    <div class="DaNgu">
                        <div class="row">
                            <div class="col-12 col-md-12">
                                <div class="form-group">
                                    <label for="ngonNguDichEdit">Ngôn ngữ dịch</label>
                                    <select class="form-control ngonNguDich" id="ngonNguDichEdit">
                                        <option value="">Chọn ngôn ngữ</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12 col-md-12">
                                <div class="form-group">
                                    <label for="tenTour">Tên tour du lịch<span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="tenTour" placeholder="Nhập tên tour du lịch" />
                                </div>
                            </div>
                            <div class="col-12 col-md-12">
                                <div class="form-group">
                                    <label for="thoiGian">Thời gian</label>
                                    <input type="text" class="form-control" id="thoiGian" placeholder="Nhập thời gian tour(vd:4 ngày 1 đêm)" />
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="moTaEdit">Mô tả</label>
                                    <textarea class="form-control" id="moTaEdit" rows="3" placeholder="Nhập mô tả"></textarea>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="traiNghiem">Các trải nghiệm của du khách khi tham gia chuyến di</label>
                                    <textarea class="form-control" id="traiNghiem" rows="3" placeholder="Nhập các trải nghiệm"></textarea>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="goiY">Các khuyến cáo, gợi ý, mẹo hữu ích dành cho du khách</label>
                                    <textarea class="form-control" id="goiY" rows="3" placeholder="Nhập khuyến cáo, gợi ý, mẹo"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="tab-pane fade" id="LoTrinh" role="tabpanel" aria-labelledby="LoTrinh-tab">
                <div class="New_Table table-responsive">
                    <div class="group-corner-button with-title">
                        <h4>Lộ trình tour du lịch</h4>
                        <div class="group-button flex-end">
                            <button type="button" class="btn btn-success" data-toggle="modal" data-target="#modalAddLoTrinh" id="btnModalAddLoTrinh">Thêm mới</button>
                        </div>
                    </div>
                    <table class="table row-border" id="dataGridDiaDiem" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Thứ tự</th>
                                <th>Địa điểm</th>
                                <th>Hoạt động</th>
                                <th>Thời điểm đến</th>
                                <th>Chức năng</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            <div class="tab-pane fade" id="TheLoaiTour" role="tabpanel" aria-labelledby="TheLoaiTour-tab">
                <div id="TheLoaiCoSan">
                    <div class="form-group">
                        <label for="theLoaiCoSanEdit">Chọn thể loại có sẵn</label>
                        <select class="form-control" id="theLoaiCoSanEdit">
                            <option value="">Chọn</option>
                        </select>
                    </div>
                </div>
                <div id="ThemTheLoai">
                    <div class="New_Table table-responsive">
                        <div class="group-corner-button with-title">
                            <h4>Thể Loại du lịch</h4>
                            <div class="group-button flex-end">
                                <button type="button" class="btn btn-success" data-toggle="modal" data-target="#modalAddDaPhuongTien" id="btnAddDaPhuongTien">Thêm mới</button>
                            </div>
                        </div>
                        <table class="table row-border" id="dataGridDaPhuongTien" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Tên thể loại</th>
                                    <th>Lĩnh vực</th>
                                    <th>Mô tả</th>
                                    <th>Trạng thái</th>
                                    <th>Chức năng</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <div class="group-button flex-end">
                        <a href="@Url.Action("Index", "TourDuLich")" class="btn btn-outline-primary">Hủy bỏ</a>
                        <button type="button" class="btn btn-primary" id="btnSaveEdit">Cập nhật</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Thêm địa điểm mới -->
    <div class="modal side-modal fade" id="modalAddDiaDiem" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="modalAddDiaDiemTitle">Thêm địa điểm mới</h4>
                    <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
                </div>
                <form role="form" id="formAddDiaDiem">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-4 col-md-6">
                                <div class="form-group">
                                    <label for="linhVucAdd">Lĩnh vực</label>
                                    <select class="form-control" id="linhVucAdd">
                                        <option value="">Chọn</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <div class="form-group">
                                    <label for="tinhThanhPhoAdd">Tỉnh/Thành phố</label>
                                    <select class="form-control" id="tinhThanhPhoAdd">
                                        <option value="">Chọn</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <div class="form-group">
                                    <label for="phuongXaAdd">Phường/Xã/Đặc khu</label>
                                    <select class="form-control" id="phuongXaAdd">
                                        <option value="">Chọn</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <div class="form-group">
                                    <label for="kinhDoAdd">Kinh độ</label>
                                    <input type="text" class="form-control" id="kinhDoAdd" placeholder="Nhập kinh độ" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <div class="form-group">
                                    <label for="viDoAdd">Vĩ độ</label>
                                    <input type="text" class="form-control" id="viDoAdd" placeholder="Nhập vĩ độ" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <div class="form-group">
                                    <label for="caoDoAdd">Cao độ</label>
                                    <input type="text" class="form-control" id="caoDoAdd" placeholder="Nhập cao độ" />
                                </div>
                            </div>
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label for="">Tùy chọn</label>
                                    <div class="div_checkbox">
                                        <div class="groupcheckbox">
                                            <input type="checkbox" id="nguoiKhuyetTatAdd" />
                                            <label for="nguoiKhuyetTatAdd">Người khuyết tật</label>
                                        </div>
                                        <div class="groupcheckbox">
                                            <input type="checkbox" id="nhaVeSinhAdd" />
                                            <label for="nhaVeSinhAdd">Nhà vệ sinh</label>
                                        </div>
                                        <div class="groupcheckbox">
                                            <input type="checkbox" id="baiDoXeAdd" />
                                            <label for="baiDoXeAdd">Bãi đỗ xe</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Đa ngữ -->
                        <div class="DaNgu">
                            <div class="row">
                                <div class="col-12 col-md-6">
                                    <div class="form-group">
                                        <label for="ngonNguDichDiaDiemAdd">Ngôn ngữ dịch</label>
                                        <select class="form-control" id="ngonNguDichDiaDiemAdd">
                                            <option value="">Chọn ngôn ngữ</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group">
                                        <label for="thoiGianHoatDongDichAdd">Thời gian hoạt động</label>
                                        <input type="text" class="form-control" id="thoiGianHoatDongDichAdd" placeholder="Nhập thời gian hoạt động" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group">
                                        <label for="tenDiaDiemDichAdd">Tên địa điểm</label>
                                        <input type="text" class="form-control" id="tenDiaDiemDichAdd" placeholder="Nhập tên địa điểm" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="form-group">
                                        <label for="sucChuaDichAdd">Sức chứa</label>
                                        <input type="number" class="form-control" id="sucChuaDichAdd" min="0" placeholder="Nhập sức chứa" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-12">
                                    <div class="form-group">
                                        <label for="diaChiDichAdd">Địa chỉ</label>
                                        <input type="text" class="form-control" id="diaChiDichAdd" placeholder="Nhập địa chỉ" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group">
                                        <label for="moTaDichAdd">Mô tả</label>
                                        <textarea class="form-control" id="moTaDichAdd" rows="3" placeholder="Nhập mô tả"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-dismiss="modal">Huỷ bỏ</button>
                        <button type="button" class="btn btn-primary" id="btnAddDiaDiem">Lưu</button>
                    </div>
                </form>
            </div><!-- modal-content -->
        </div><!-- modal-dialog -->
    </div><!-- modal -->
    <!-- Modal Thêm lộ trình mới -->
    <div class="modal side-modal fade" id="modalAddLoTrinh" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="modalAddLoTrinhTitle">Thêm lộ trình tour</h4>
                    <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
                </div>
                <form role="form" id="formAddLoTrinh">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-4 col-md-6">
                                <div class="form-group">
                                    <label for="diaDiemLoTrinhAdd">Địa điểm <span class="text-danger">*</span></label>
                                    <select class="form-control" id="diaDiemLoTrinhAdd">
                                        <option value="">Chọn địa điểm</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <div class="form-group">
                                    <label for="thoiDiemLoTrinhAdd">Thời điểm đến dự kiến <span class="text-danger">*</span></label>
                                    <input type="datetime-local" class="form-control" id="thoiDiemLoTrinhAdd" />
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-6">
                                <div class="form-group">
                                    <label for="thuTuLoTrinhAdd">Thứ tự ghé thăm <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="thuTuLoTrinhAdd" min="1" max="255" placeholder="Nhập thứ tự" />
                                </div>
                            </div>
                        </div>

                        <!-- Section quản lý hoạt động -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Danh sách hoạt động tại địa điểm</h5>
                            </div>
                            <div class="col-lg-8 col-md-8">
                                <div class="form-group">
                                    <label for="hoatDongLoTrinhAdd">Hoạt động chính</label>
                                    <textarea class="form-control" id="hoatDongLoTrinhAdd" rows="2" placeholder="Nhập hoạt động chính tại địa điểm này"></textarea>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3">
                                <div class="form-group">
                                    <label for="soGioLoTrinhAdd">Số giờ</label>
                                    <input type="text" class="form-control" id="soGioLoTrinhAdd" placeholder="VD: 2, 1.5" />
                                </div>
                            </div>
                            <div class="col-lg-1 col-md-1">
                                <div class="form-group">
                                    <label>&nbsp;</label>
                                    <button type="button" style="float:right;" class="hgi-icon hgi-add" id="btnAddRow" onclick="addNoiDungToLoTrinh()"></button>
                                </div>
                            </div>
                        </div>

                        <!-- Bảng hiển thị hoạt động -->
                        <div class="row">
                            <div class="col-12">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm" id="tableNoiDungLoTrinh">
                                        <thead class="table-light">
                                            <tr>
                                                <th width="50px">STT</th>
                                                <th>Hoạt động</th>
                                                <th width="100px">Thời gian</th>
                                                <th width="80px">Chức năng</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Data will be populated by JavaScript -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-dismiss="modal">Huỷ bỏ</button>
                        <button type="submit" class="btn btn-primary">Lưu lộ trình</button>
                    </div>
                </form>
            </div><!-- modal-content -->
        </div><!-- modal-dialog -->
    </div><!-- modal -->
    <!-- Modal Thêm thể loại du lịch -->
    <div class="modal side-modal fade" id="modalAddDaPhuongTien" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="modalAddDaPhuongTienTitle">Thêm thể loại du lịch</h4>
                    <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
                </div>
                <form role="form" id="formAddDaPhuongTien">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group">
                                    <label for="tenTheLoaiAdd">Tên thể loại</label>
                                    <input type="text" class="form-control" id="tenTheLoaiAdd" placeholder="Nhập tên thể loại" />
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6">
                                <div class="form-group">
                                    <label for="moTaTheLoaiAdd">Mô tả</label>
                                    <input type="text" class="form-control" id="moTaTheLoaiAdd" placeholder="Nhập mô tả" />
                                </div>
                            </div>

