@model CSDLVanHoaDuLichSonLa.Models.ViewPermissionViewModel

<div class="box_content">
    <div class="TieuDe">
        <h2 id="pageTitle">@ViewBag.Title</h2>
    </div>

    <div class="content-body">
        <input type="hidden" id="daoTaoID" value="@ViewBag.DaoTaoID" />

        <!-- Thông tin cơ bản -->
        <div class="row">
            <!-- Cột trái -->
            <div class="col-lg-6 col-md-6">
                <div class="form-group form-info">
                    <label>Lĩnh vực đào tạo:</label>
                    <span id="linhVuc" class="text-bold">-</span>
                </div>
                <div class="form-group form-info">
                    <label>Đơn vị tổ chức:</label>
                    <span id="toChuc" class="text-bold">-</span>
                </div>
                <div class="form-group form-info">
                    <label>Địa điểm tổ chức:</label>
                    <span id="diaDiem" class="text-bold">-</span>
                </div>
                
            </div>

            <!-- Cột phải -->
            <div class="col-lg-6 col-md-6">
                <div class="form-group form-info">
                    <label>Thời gian bắt đầu:</label>
                    <span id="batDau" class="text-bold">-</span>
                </div>
                <div class="form-group form-info">
                    <label>Thời gian kết thúc:</label>
                    <span id="ketThuc" class="text-bold">-</span>
                </div>
                <div class="form-group form-info">
                    <label>Trạng thái:</label>
                    <span id="trangThai" class="text-bold">-</span>
                </div>
            </div>

            <!-- Thông tin chi tiết -->
            <div class="col-lg-12 col-md-12">
                <div class="form-group form-info">
                    <label>Nội dung đào tạo:</label>
                    <span id="noiDungDaoTao" class="text-bold">-</span>
                </div>
                <div class="form-group form-info">
                    <label>Đơn vị:</label>
                    <span id="donVi">-</span>
                </div>
            </div>
        </div>

        <!-- Thông tin người tạo/cập nhật -->
        @* <div class="sub-text">
            <ul class="list-updater">
                <li>Người tạo: <span id="nguoiTao">-</span></li>
                <li>Ngày tạo: <span id="ngayTao">-</span></li>
                <li>Người cập nhật: <span id="nguoiCapNhat">-</span></li>
                <li>Ngày cập nhật: <span id="ngayCapNhat">-</span></li>
            </ul>
        </div> *@
    </div>
</div>

@section Scripts {
    <script>
        const daoTaoID = '@ViewBag.DaoTaoID';
    </script>
    <script src="~/PageScripts/admin/DaoTaoBoiDuong/Details.js" asp-append-version="true"></script>
}